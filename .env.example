# Copy to .env for local development. Never commit .env.
# All values below are safe local defaults; no credentials are required for the mock provider.

HOST=127.0.0.1
PORT=3000

# Chat provider. Only "mock" is available until an AI provider is approved.
CHAT_PROVIDER=mock
CHAT_TIMEOUT_MS=15000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=10

# Mock provider options
CHAT_MOCK_DELAY_MS=600
# When true, sending "/simulate-error" in the chat triggers a server error (for testing the error UI).
CHAT_MOCK_SIMULATE_ERRORS=false

# [PENDING] Live provider key, read server-side only by the approved provider module.
# Leave empty. Use a development key with a spending cap when a provider is approved.
AI_PROVIDER_API_KEY=

# Where runtime data (edited tests, attempts) is stored. Defaults to data/runtime/.
# DATA_DIR=

# Admin sign-in (leave empty to keep admin disabled).
# Generate the hash with: npm run admin:hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_MINUTES=60
# Set to true when served over HTTPS (staging/production).
COOKIE_SECURE=false
